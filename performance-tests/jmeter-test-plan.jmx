        <stringProp name="Argument.value">CUST${__Random(1000,9999)}</stringProp>
        <stringProp name="Argument.metadata">=</stringProp>
        <boolProp name="HTTPArgument.use_equals">true</boolProp>
      </elementProp>
      <elementProp name="features" elementType="HTTPArgument">
        <boolProp name="HTTPArgument.always_encode">false</boolProp>
        <stringProp name="Argument.name">features</stringProp>
        <stringProp name="Argument.value">{"age":${__Random(18,80)},"income":${__Random(20000,100000)},"employment_years":${__Random(0,40)},"debt_ratio":${__Random(0,1)},"revolving_utilization":${__Random(0,1)}}</stringProp>
